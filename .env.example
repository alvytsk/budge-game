# Copy to `.env` and fill in. `.env` is not committed.

# --- database -------------------------------------------------------------
POSTGRES_USER=budge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=budge

# --- object store (§10) ---------------------------------------------------
MINIO_ROOT_USER=budge
MINIO_ROOT_PASSWORD=change-me-too

# --- application ----------------------------------------------------------
# Any long random string. `openssl rand -hex 32` will do.
# Changing it invalidates every session cookie and every stage link.
BUDGE_SECRET_KEY=

# The output of:  echo -n 'the password' | docker run --rm -i budge-api budge hash-password
# Double every `$` in that output before pasting it here: Compose reads
# this file with variable interpolation, so a lone `$1` in an scrypt hash
# expands to nothing and the API is left with a truncated hash that no
# password can ever match. `scrypt$16384$...` becomes `scrypt$$16384$$...`.
BUDGE_HOST_PASSWORD=

# --- backups (§10) --------------------------------------------------------
# Seconds between backups, and between restore drills. One hour and one day.
BUDGE_BACKUP_INTERVAL=3600
BUDGE_DRILL_INTERVAL=86400
